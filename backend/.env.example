# ── LLM providers ───────────────────────────────────────────────
# Comma-separated Gemini API keys (rotated for throughput/failover).
GOOGLE_API_KEYS=key1,key2,key3
# Final fallback provider (used when all Gemini keys are exhausted).
GROQ_API_KEY=

# Optional model overrides (sensible defaults are baked in).
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_FALLBACK=gemini-2.5-flash-lite
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768

# Max output tokens per provider. Gemini is set to its model maximum so the
# thinking model never truncates output; Groq stays within its lower ceiling.
GEMINI_MAX_OUTPUT_TOKENS=65536
GROQ_MAX_OUTPUT_TOKENS=8192

# ── Storage backend ─────────────────────────────────────────────
# "local" (default): SQLite + NumPy vectors, zero external infra.
# "supabase": Postgres + pgvector for production.
STORE_BACKEND=local
LOCAL_DATA_DIR=./data

# ── Data / services (from M1) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# ── Auth (from M8) ──────────────────────────────────────────────
# Set to enable Supabase JWT auth; leave blank to run no-login demo mode.
SUPABASE_JWT_SECRET=

# ── Payments (from M8) ──────────────────────────────────────────
# Leave blank to disable billing (demo runs unlimited, no checkout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Where Stripe Checkout returns the user (your deployed frontend URL).
FRONTEND_URL=http://localhost:3000

# ── Web augmentation (from M10) ─────────────────────────────────
# Optional: enables the labeled web fallback when the corpus can't answer.
TAVILY_API_KEY=

# ── App ─────────────────────────────────────────────────────────
# Comma-separated allowed origins (the Vercel frontend + local dev).
CORS_ORIGINS=http://localhost:3000
PORT=7860
